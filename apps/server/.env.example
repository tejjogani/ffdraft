# Pavé server configuration. Every variable is optional.

# HTTP port and interface. Local mode binds to 127.0.0.1 unless HOST is set; accounts mode to 0.0.0.0.
PORT=8787
# HOST=127.0.0.1

# Postgres connection string. Unset → embedded PGlite (PostgreSQL 18) under PAVE_DATA_DIR.
# Use the same Postgres major (18) in production so data can move between the two.
# DATABASE_URL=postgres://pave:pave@localhost:5432/pave

# Where the embedded database, blobs and the generated local auth secret live.
# Default: <repo>/.data. Relative paths resolve against the working directory.
# PAVE_DATA_DIR=./.data

# local    → no sign-in: one auto-provisioned user and organisation (default without DATABASE_URL).
# accounts → email + password accounts, organisations, invitations (default with DATABASE_URL).
# PAVE_AUTH=local

# Required in accounts mode (32+ characters), e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`.
# BETTER_AUTH_SECRET=

# The URL people reach the server at (auth callbacks, trusted origin).
# PAVE_PUBLIC_URL=http://localhost:8787

# Extra browser origins allowed to call the API with credentials (comma-separated).
# PAVE_CORS_ORIGINS=http://localhost:5173

# Create the welcome workspace on first run in local mode (1/0).
# PAVE_SEED=1

# Built studio to serve from this process. Default: <repo>/apps/studio/dist (served only if it exists).
# PAVE_STUDIO_DIST=

# Largest accepted upload, in megabytes.
# PAVE_MAX_UPLOAD_MB=200

# production disables output validation against the contract and request logging.
# NODE_ENV=development

# ── Core engines (src/engines) ──────────────────────────────────────────────────────────────
# Kernel worker threads for evaluation, export and packaging. Default: CPUs − 1, between 1 and 4.
# PAVE_KERNEL_WORKERS=3
# A worker holding more than this (JS heap + WASM, which never shrinks) is retired once idle.
# PAVE_KERNEL_MEMORY_MB=1536
# Pieces each worker keeps warm (each keeps its cached geometry until the worker is retired).
# PAVE_KERNEL_PIECES_PER_WORKER=3
# Production packages built at once (each occupies one kernel worker).
# PAVE_PRODUCTION_CONCURRENCY=1
# Blender renders at once; Cycles already uses every core.
# PAVE_RENDER_CONCURRENCY=1
# Blender is found through PAVE_PYTHON (a Python with bpy), PAVE_BLENDER (a Blender 5.3
# executable) or workers/render/.venv; renders.configureEngine saves a choice to
# <PAVE_DATA_DIR>/engine.json.
# PAVE_PYTHON=
# PAVE_BLENDER=

# ── Assistant (Claude) ──────────────────────────────────────────────────────────────────────
# A Claude API key, from the API keys page of the Claude Console. Set here, it takes precedence
# over a key saved in Settings, AI (which then cannot be edited there). Check it with `pnpm agent:smoke`.
# ANTHROPIC_API_KEY=
# The tier new conversations start on (power, standard or light), and the model each tier runs on.
# These win over Settings, AI. Models: claude-fable-5-2, claude-opus-5-5, claude-sonnet-5-5,
# claude-haiku-5-5. Defaults: power = claude-fable-5-2, standard = claude-opus-5-5,
# light = claude-sonnet-5-5.
# PAVE_ASSISTANT_TIER=standard
# PAVE_ASSISTANT_MODEL_POWER=claude-fable-5-2
# PAVE_ASSISTANT_MODEL_STANDARD=claude-opus-5-5
# PAVE_ASSISTANT_MODEL_LIGHT=claude-sonnet-5-5

# Testing only: play canned turns from apps/server/src/assistant/fixtures/<name>.json instead of
# calling Claude (no key needed). Refused with NODE_ENV=production; the server prints a warning.
# Never set this for real use.
# PAVE_ASSISTANT=scripted:brief-to-ring
