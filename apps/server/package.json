{
  "name": "@pave/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json",
    "seed": "tsx src/seed-cli.ts",
    "smoke": "tsx src/smoke-cli.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.14.0",
    "@electric-sql/pglite": "0.5.17",
    "@hono/node-server": "2.1.11",
    "@pave/agent": "workspace:*",
    "@pave/canon": "workspace:*",
    "@pave/kernel": "workspace:*",
    "@pave/match": "workspace:*",
    "@pave/production": "workspace:*",
    "@pave/render": "workspace:*",
    "@pave/schema": "workspace:*",
    "better-auth": "1.7.27",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.21",
    "pg": "8.23.1",
    "sharp": "0.35.5",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "fflate": "^0.8.3",
    "pdf-lib": "^1.17.1",
    "rhino3dm": "^8.35.0"
  }
}
