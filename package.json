{
  "name": "pave",
  "private": true,
  "version": "0.1.0",
  "description": "Pavé — open-source, AI-native jewelry design: ideate, CAD, render, on-model, production.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm --parallel --filter @pave/server --filter @pave/studio dev",
    "dev:studio": "pnpm --filter @pave/studio dev",
    "dev:server": "pnpm --filter @pave/server dev",
    "build": "pnpm --filter @pave/studio build",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome check --write .",
    "seed": "pnpm --filter @pave/server seed"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^22.19.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
